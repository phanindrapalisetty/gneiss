[Unit]
Description=Gneiss Homelab
Requires=docker.service
After=docker.service network-online.target
RequiresMountsFor=/mnt/storage

[Service]
Type=oneshot
RemainAfterExit=yes
User=phanindra
WorkingDirectory=/home/phanindra/Projects/gneiss

ExecStart=/usr/bin/make -C /home/phanindra/Projects/gneiss up
ExecStop=/usr/bin/make -C /home/phanindra/Projects/gneiss stop

TimeoutStartSec=300

[Install]
WantedBy=multi-user.target